---
import { localizePaper } from "../../lib/paper-home";
const { lang = "zh" } = Astro.props;
const markup = "<div class=\"review\" aria-hidden=\"true\"><span>纸窗 · Sand & glass</span><div class=\"palette-chooser\" role=\"group\" aria-label=\"配色\"><button data-palette=\"blue\" aria-pressed=\"true\" aria-label=\"Blue porcelain\"><i></i><span>Blue</span></button><button data-palette=\"ink\" aria-pressed=\"false\" aria-label=\"Ink blue\"><i></i><span>Ink</span></button><button data-palette=\"mist\" aria-pressed=\"false\" aria-label=\"Mist blue\"><i></i><span>Mist</span></button></div></div><nav class=\"page-ruler\" aria-label=\"页面刻度导航\"><div class=\"ruler-slider\" role=\"slider\" tabindex=\"0\" aria-label=\"拖动或点击切换板块\" aria-orientation=\"vertical\" aria-valuemin=\"0\" aria-valuemax=\"10\" aria-valuenow=\"0\" aria-valuetext=\"首页\"><div class=\"ruler-line\"></div><div class=\"ruler-ticks\" aria-hidden=\"true\"></div><div class=\"ruler-thumb\" aria-hidden=\"true\"></div></div><span class=\"ruler-caption\" aria-hidden=\"true\">首页</span><span class=\"ruler-count\" aria-hidden=\"true\">00</span></nav>\n<dialog class=\"explore-dialog\"><header><span data-zh=\"内容与交互试样\" data-en=\"Content & interaction study\">内容与交互试样</span><button class=\"explore-close\" aria-label=\"关闭\">×</button></header><div class=\"explore-body\"></div></dialog><dialog class=\"image-dialog\"><button autofocus data-zh=\"关闭大图\" data-en=\"Close image\">关闭大图</button><img alt=\"作品内容图片\"></dialog>";
---
<Fragment set:html={localizePaper(markup,lang)} />
