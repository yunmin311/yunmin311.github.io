---
import { localizePaper } from "../../lib/paper-home";
const { lang = "zh" } = Astro.props;
const markup = "<section class=\"content writing-section folio-sheet\" id=\"writing\"><div class=\"section-heading\"><h2 data-zh=\"文字\" data-en=\"Writing\">文字</h2><p data-zh=\"随笔与过程手记。\" data-en=\"Notes and process.\">随笔与过程手记。</p></div><div class=\"writing-shelf\"><div class=\"reading-tools\"><span data-zh=\"随笔 / 现有占位内容\" data-en=\"Notes / Existing placeholders\">随笔 / 现有占位内容</span><div><button data-reading-view=\"shelf\" aria-pressed=\"true\" data-zh=\"书架\" data-en=\"Shelf\">书架</button><button data-reading-view=\"list\" aria-pressed=\"false\" data-zh=\"目录\" data-en=\"Index\">目录</button></div></div><div class=\"writing-list\"><button data-post=\"hello\"><span class=\"post-date\">2026.07</span><span class=\"post-title\" data-zh=\"你好\" data-en=\"Hello\">你好</span><span class=\"post-type\" data-zh=\"现有占位文章\" data-en=\"Existing placeholder\">现有占位文章</span><span>↗</span></button><button data-post=\"process-notes\" class=\"zh-only\"><span class=\"post-date\">2026.06</span><span class=\"post-title\">过程手记</span><span class=\"post-type\">现有中文版占位文章</span><span>↗</span></button></div></div></section><section class=\"content about-section folio-sheet\" id=\"about\"><h2 data-zh=\"关于\" data-en=\"About\">关于</h2><div class=\"about-copy\"><p data-zh=\"这里会放更完整的个人介绍：正在做的事、背景，以及慢慢形成的兴趣。\" data-en=\"A space for a fuller introduction: current work, background, and interests taking shape.\">这里会放更完整的个人介绍：正在做的事、背景，以及慢慢形成的兴趣。</p><p class=\"pending\" data-zh=\"旧项目的个人介绍已保留为待确认草稿，联系方式仍待补。\" data-en=\"The earlier introduction is preserved as a draft for review. Contact details are pending.\">旧项目的个人介绍已保留为待确认草稿，联系方式仍待补。</p><div class=\"contact-row\"><a href=\"https://github.com/yunmin311\" target=\"_blank\" rel=\"noopener\">GitHub ↗</a><span class=\"pending\" data-zh=\"邮箱 · 待补\" data-en=\"Email · Pending\">邮箱 · 待补</span><span class=\"pending\" data-zh=\"Instagram · 待补\" data-en=\"Instagram · Pending\">Instagram · 待补</span><span class=\"pending\" data-zh=\"Behance · 待补\" data-en=\"Behance · Pending\">Behance · 待补</span><span class=\"pending\" data-zh=\"简历 · 待补\" data-en=\"Resume · Pending\">简历 · 待补</span></div></div></section><footer class=\"bottom\"><span>Yunmin / yunmin311.github.io</span><button class=\"reduce\" aria-pressed=\"false\" data-zh=\"减少动效\" data-en=\"Reduce motion\">减少动效</button><a href=\"https://github.com/yunmin311\" target=\"_blank\" rel=\"noopener\">GitHub ↗</a></footer>";
---
<Fragment set:html={localizePaper(markup,lang)} />
