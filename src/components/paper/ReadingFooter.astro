---
import { localizePaper } from "../../lib/paper-home";
import {profile} from "../../lib/profile";
const { lang = "zh" } = Astro.props;
const markup = "<section class=\"content writing-section folio-sheet\" id=\"writing\"><div class=\"section-heading\"><h2 data-zh=\"文字\" data-en=\"Writing\">文字</h2><p data-zh=\"当前文章尚未发布；保留历史草稿。\" data-en=\"No current articles published; earlier drafts remain in the archive.\">当前文章尚未发布；保留历史草稿。</p></div><div class=\"writing-shelf\"><div class=\"reading-tools\"><span data-zh=\"Archive / 2026-05\" data-en=\"Archive / 2026-05\">Archive / 2026-05</span><div><button data-reading-view=\"shelf\" aria-pressed=\"true\" data-zh=\"书架\" data-en=\"Shelf\">书架</button><button data-reading-view=\"list\" aria-pressed=\"false\" data-zh=\"目录\" data-en=\"Index\">目录</button></div></div><div class=\"writing-list\"></div></div></section><section class=\"content about-section folio-sheet\" id=\"about\"><h2 data-zh=\"关于\" data-en=\"About\">关于</h2><div class=\"about-copy\"><p data-zh=\"__ABOUT_ZH__\" data-en=\"__ABOUT_EN__\">__ABOUT_ZH__</p><p class=\"pending\" data-zh=\"__INTERESTS_ZH__\" data-en=\"__INTERESTS_EN__\">__INTERESTS_ZH__</p><div class=\"contact-row\"><a href=\"https://github.com/yunmin311\" target=\"_blank\" rel=\"noopener\">GitHub ↗</a><span class=\"pending\" data-zh=\"邮箱 · 待补\" data-en=\"Email · Pending\">邮箱 · 待补</span><span class=\"pending\" data-zh=\"Instagram · 待补\" data-en=\"Instagram · Pending\">Instagram · 待补</span><span class=\"pending\" data-zh=\"Behance · 待补\" data-en=\"Behance · Pending\">Behance · 待补</span><span class=\"pending\" data-zh=\"简历 · 待补\" data-en=\"Resume · Pending\">简历 · 待补</span></div></div></section><footer class=\"bottom\"><span>Yunmin / yunmin311.github.io</span><button class=\"reduce\" aria-pressed=\"false\" data-zh=\"减少动效\" data-en=\"Reduce motion\">减少动效</button><a href=\"https://github.com/yunmin311\" target=\"_blank\" rel=\"noopener\">GitHub ↗</a></footer>".replaceAll('__ABOUT_ZH__',profile.name+'，'+profile.education.zh+'。'+profile.intro.zh).replaceAll('__ABOUT_EN__',profile.name+'. '+profile.education.en+'. '+profile.intro.en).replaceAll('__INTERESTS_ZH__',profile.about.zh+' '+profile.principle.zh).replaceAll('__INTERESTS_EN__',profile.about.en+' '+profile.principle.en);
---
<Fragment set:html={localizePaper(markup,lang)} />
