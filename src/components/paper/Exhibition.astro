---
import {localizePaper} from "../../lib/paper-home";
import WorksSection from "./WorksSection.astro";
const {lang="zh"}=Astro.props;
const before="<nav class=\"section-map\" aria-label=\"全部板块\"><a href=\"#works\" data-zh=\"作品\" data-en=\"Works\">作品</a><a hidden href=\"#photos\" data-zh=\"影集\" data-en=\"Photos\">影集</a><a hidden href=\"#podcast\" data-zh=\"播客\" data-en=\"Podcast\">播客</a><a href=\"#projects\" data-zh=\"项目 / 存档\" data-en=\"Projects / Archive\">项目 / 存档</a><a href=\"#learning\" data-zh=\"知识入口\" data-en=\"Knowledge\">知识入口</a><a href=\"#design-notes\" data-zh=\"本站设计系统\" data-en=\"Site study\">本站设计系统</a><a href=\"#assets\" data-zh=\"本站素材试样\" data-en=\"Site assets\">本站素材试样</a><a href=\"#repos\" data-zh=\"代码库\" data-en=\"Repos\">代码库</a><a href=\"#writing\" data-zh=\"文字\" data-en=\"Writing\">文字</a></nav>\n";
const after="\n<div class=\"exhibition content\">\n<details class=\"site-study-fold\"><summary data-zh=\"影集待补 / 图像与声音试样\" data-en=\"Photography pending / Image & sound studies\">影集待补 / 图像与声音试样</summary><div class=\"spread-label\"><span data-zh=\"图像与声音\" data-en=\"Images & sound\">图像与声音</span><span data-zh=\"照片带 / 播放页\" data-en=\"Photo strip / Listening page\">照片带 / 播放页</span></div><div class=\"media-spread folio-sheet\">\n<section id=\"photos\" class=\"photo-section\"><div class=\"mini-head\"><h2 data-zh=\"影集\" data-en=\"Photos\">影集</h2><button data-explore=\"album\" data-zh=\"打开相册 ↗\" data-en=\"Open album ↗\">打开相册 ↗</button></div><p class=\"section-note\" data-zh=\"公共纸卡影集 · CC0 试样，非个人摄影\" data-en=\"Public postcard album · CC0 study, not personal photography\">公共纸卡影集 · CC0 试样，非个人摄影</p><div class=\"album-tools\"><span data-zh=\"公共素材 / 3 张\" data-en=\"Public assets / 3 photos\">公共素材 / 3 张</span><div><button class=\"album-prev\" aria-label=\"上一张照片\">←</button><button class=\"album-next\" aria-label=\"下一张照片\">→</button></div></div><div class=\"photo-strip\"><button data-photo=\"0\" class=\"photo-print\"><span class=\"atlas-photo photo-city\"></span><span data-zh=\"沿着水面\" data-en=\"Along the water\">沿着水面</span></button><button data-photo=\"1\" class=\"photo-print\"><span class=\"atlas-photo photo-ocean\"></span><span data-zh=\"走到海边\" data-en=\"At the coast\">走到海边</span></button><button data-photo=\"2\" class=\"photo-print\"><span class=\"atlas-photo photo-forest\"></span><span data-zh=\"经过树林\" data-en=\"Through the trees\">经过树林</span></button></div><p class=\"small-line\" data-zh=\"点击看大图 / 相册信息位：时间、地点待补\" data-en=\"Click to enlarge / Album date and location pending\">点击看大图 / 相册信息位：时间、地点待补</p></section>\n<section id=\"podcast\" class=\"podcast-section\"><div class=\"mini-head\"><h2 data-zh=\"播客\" data-en=\"Podcast\">播客</h2><button data-explore=\"podcast\" data-zh=\"本期笔记 ↗\" data-en=\"Show notes ↗\">本期笔记 ↗</button></div><div class=\"record-art\"><div class=\"vinyl\"><div class=\"vinyl-label\"><span>01</span><i></i></div></div><div class=\"record-caption\"><span>Sound study / 01</span><p data-zh=\"还未命名的一期\" data-en=\"An untitled episode\">还未命名的一期</p><small data-zh=\"封面与播放交互试样\" data-en=\"Cover and playback study\">封面与播放交互试样</small></div></div><div class=\"player-deck\"><audio id=\"podcast-audio\" controls preload=\"none\" data-study-source=\"/assets/paper/music-study.json\"></audio></div><div class=\"player-console\" hidden><div class=\"audio-control\"><button class=\"audio-play\" aria-pressed=\"false\" data-zh=\"试听\" data-en=\"Listen\">试听</button><svg class=\"waveform\" viewBox=\"0 0 240 36\" aria-hidden=\"true\"></svg><span class=\"audio-time\">00:00</span></div><input class=\"audio-seek\" type=\"range\" min=\"0\" max=\"24\" value=\"0\" step=\".1\" aria-label=\"声音试样播放位置\"></div><p class=\"small-line\" data-zh=\"24 秒合成声音，仅用于体验操作，非真实节目。\" data-en=\"24 seconds of synthesized sound for testing; not a real episode.\">24 秒合成声音，仅用于体验操作，非真实节目。</p></section>\n</div>\n</details><div class=\"spread-label\"><span data-zh=\"过程与学习\" data-en=\"Process & learning\">过程与学习</span><a href=\"#works\" data-zh=\"回看成品 ↗\" data-en=\"Back to the work ↗\">回看成品 ↗</a></div><div class=\"notebook-spread folio-sheet\">\n<section id=\"projects\" class=\"projects-section\"><div class=\"mini-head\"><h2 data-zh=\"项目 / 存档\" data-en=\"Projects / Archive\">项目 / 存档</h2><span>Historical / 2026-05</span></div><div class=\"process-book\"><p class=\"source-note\" data-zh=\"六个早期想法的状态来自 2026-05 原稿，不代表当前进度。现在的实现见作品与代码库。\" data-en=\"Six earlier ideas retain their 2026-05 status, not current progress. Current implementations are in Works and Repos.\">六个早期想法的状态来自 2026-05 原稿，不代表当前进度。现在的实现见作品与代码库。</p><div class=\"archive-index\"></div></div></section>\n<section id=\"learning\" class=\"learning-section\"><div class=\"mini-head\"><h2 data-zh=\"知识入口\" data-en=\"Knowledge links\">知识入口</h2><span data-zh=\"公开知识项目\" data-en=\"Public knowledge projects\">公开知识项目</span></div><div class=\"learning-paper\"><span class=\"page-number\">01 / 03</span><div class=\"note-page-tabs\" aria-label=\"选择笔记页\"><button data-note-page=\"0\" aria-pressed=\"true\">01</button><button data-note-page=\"1\" aria-pressed=\"false\">02</button><button data-note-page=\"2\" aria-pressed=\"false\">03</button></div><h3 class=\"learning-title\" data-zh=\"排版的留白\" data-en=\"Space in typography\">排版的留白</h3><p class=\"learning-summary\" data-zh=\"练习页：字、图和间距，怎样互相让出空间。\" data-en=\"Study page: how type, pictures, and gaps share space.\">练习页：字、图和间距，怎样互相让出空间。</p><p class=\"small-line\" data-zh=\"以下是公开项目资料入口；个人学习笔记尚未发布。\" data-en=\"Links to public project documentation; no personal learning notes are published yet.\">以下是公开项目资料入口；个人学习笔记尚未发布。</p><div class=\"page-turn\"><button class=\"learning-prev\" aria-label=\"上一页\">←</button><button data-explore=\"learning\" data-zh=\"展开这页\" data-en=\"Open this page\">展开这页</button><button class=\"learning-next\" aria-label=\"下一页\">→</button></div><div class=\"folio-links\"><a href=\"#design-notes\" data-zh=\"看看本站设计系统 ↗\" data-en=\"Explore design notes ↗\">看看本站设计系统 ↗</a></div></div></section>\n</div>\n<div class=\"spread-label\"><span data-zh=\"研究与材料\" data-en=\"Research & materials\">研究与材料</span><a href=\"#learning\" data-zh=\"沿着学习线 ↗\" data-en=\"Follow the learning ↗\">沿着学习线 ↗</a></div><div class=\"research-spread folio-sheet\">\n<section id=\"design-notes\" class=\"design-section\"><div class=\"mini-head\"><h2 data-zh=\"本站设计系统\" data-en=\"Site study\">本站设计系统</h2><span data-zh=\"Site study / 非个人项目\" data-en=\"Site study / Not a personal project\">Site study / 非个人项目</span></div><div class=\"design-tabs\"><button data-design=\"type\" aria-pressed=\"true\" data-zh=\"排版\" data-en=\"Type\">排版</button><button data-design=\"color\" aria-pressed=\"false\" data-zh=\"配色\" data-en=\"Color\">配色</button><button data-design=\"motion\" aria-pressed=\"false\" data-zh=\"交互\" data-en=\"Motion\">交互</button></div><button class=\"design-preview\" data-explore=\"design\"><div class=\"design-art type-art\"><span>Aa</span><span>字</span><i>44 / 16</i></div><p class=\"design-title\" data-zh=\"两级字形关系\" data-en=\"Two levels of typography\">两级字形关系</p><small data-zh=\"本轮页面的真实数值 / 实测试样 ↗\" data-en=\"Actual values used on this page / Study ↗\">本轮页面的真实数值 / 实测试样 ↗</small></button></section>\n<section id=\"assets\" class=\"assets-section\"><div class=\"mini-head\"><h2 data-zh=\"本站素材试样\" data-en=\"Site assets\">本站素材试样</h2><span data-zh=\"可看，也可取走\" data-en=\"Look, use, keep\">可看，也可取走</span></div><div class=\"asset-tabs\"><button data-asset-filter=\"all\" aria-pressed=\"true\" data-zh=\"全部\" data-en=\"All\">全部</button><button data-asset-filter=\"color\" aria-pressed=\"false\" data-zh=\"配色\" data-en=\"Colors\">配色</button><button data-asset-filter=\"paper\" aria-pressed=\"false\" data-zh=\"纸张\" data-en=\"Paper\">纸张</button><button data-asset-filter=\"graphic\" aria-pressed=\"false\" data-zh=\"图形\" data-en=\"Graphics\">图形</button></div><div class=\"asset-shelf\"><div class=\"asset-object\" data-asset-type=\"color\"><span class=\"asset-kind\" data-zh=\"色卡\" data-en=\"Palette\">色卡</span><div class=\"swatch-stack\"><button data-copy=\"#D0E3EB\" style=\"--swatch:#d0e3eb\" aria-label=\"复制蓝色值\">#D0E3EB</button><button data-copy=\"#DCE4DB\" style=\"--swatch:#dce4db\" aria-label=\"复制色值\">#DCE4DB</button><button data-copy=\"#E3DEE8\" style=\"--swatch:#e3dee8\" aria-label=\"复制色值\">#E3DEE8</button><button data-copy=\"#F0ECE2\" style=\"--swatch:#f0ece2\" aria-label=\"复制色值\">#F0ECE2</button></div><p data-zh=\"这一页的配色\" data-en=\"Colors from this page\">这一页的配色</p><small data-zh=\"点击复制 / 信息卡试样\" data-en=\"Click to copy / Palette study\">点击复制 / 信息卡试样</small></div><button class=\"asset-object paper-object\" data-asset-type=\"paper\" data-explore=\"paper\"><span class=\"asset-kind\" data-zh=\"纹理\" data-en=\"Texture\">纹理</span><div class=\"paper-sample\"></div><p>Paper 001</p><small>ambientCG / CC0</small></button><button class=\"asset-object graphic-object\" data-asset-type=\"graphic\" data-explore=\"graphic\"><span class=\"asset-kind\" data-zh=\"图形\" data-en=\"Graphic\">图形</span><div class=\"bookmark-art\"><svg viewBox=\"0 0 120 150\" aria-hidden=\"true\"><path d=\"M30 15h60v115l-30-21-30 21z\" fill=\"#5c7b8b\"/><path d=\"M30 15h60L30 55z\" fill=\"#a4bdb4\"/><path d=\"M30 55 90 15\" stroke=\"#fff8\"/><circle cx=\"60\" cy=\"37\" r=\"3\" fill=\"#fafbf8\"/></svg></div><p data-zh=\"折纸书签 ↗\" data-en=\"Folded bookmark ↗\">折纸书签 ↗</p><small data-zh=\"本轮图形试样 / SVG\" data-en=\"Graphic study / SVG\">本轮图形试样 / SVG</small></button><button class=\"asset-object sand-object\" data-asset-type=\"paper\" data-explore=\"sand-blue\" data-material-key=\"sand-blue\"><span class=\"asset-kind\" data-zh=\"纹理 / 试样\" data-en=\"Texture / Study\">纹理 / 试样</span><span class=\"sand-sample\" aria-hidden=\"true\"></span><p data-zh=\"蓝色纹理 ↗\" data-en=\"Blue pigment ↗\">蓝色纹理 ↗</p><small data-zh=\"生成素材 / 非个人作品\" data-en=\"Generated material / Study\">生成素材 / 非个人作品</small></button><button class=\"asset-object sand-object\" data-asset-type=\"paper\" data-explore=\"sand-sage\" data-material-key=\"sand-sage\"><span class=\"asset-kind\" data-zh=\"纹理 / 试样\" data-en=\"Texture / Study\">纹理 / 试样</span><span class=\"sand-sample\" aria-hidden=\"true\"></span><p data-zh=\"灰绿纹理 ↗\" data-en=\"Sage pigment ↗\">灰绿纹理 ↗</p><small data-zh=\"生成素材 / 非个人作品\" data-en=\"Generated material / Study\">生成素材 / 非个人作品</small></button></div><p class=\"copy-status\" aria-live=\"polite\"></p></section>\n</div>\n<section id=\"repos\" class=\"repos-section folio-sheet\"><div class=\"folio-mark\" data-zh=\"实现 / 项目名片\" data-en=\"Implementation / Project cards\">实现 / 项目名片</div><div class=\"mini-head\"><h2 data-zh=\"代码库\" data-en=\"Repos\">代码库</h2><span data-zh=\"精选代码入口\" data-en=\"Selected code entries\">精选代码入口</span></div><div class=\"repo-tools\"><button data-repo-filter=\"all\" aria-pressed=\"true\" data-zh=\"全部\" data-en=\"All\">全部</button><button data-repo-filter=\"project\" aria-pressed=\"false\" data-zh=\"正式\" data-en=\"Projects / Archive\">正式</button><button data-repo-filter=\"practice\" aria-pressed=\"false\" data-zh=\"练习\" data-en=\"Practice\">练习</button></div><div class=\"repo-folders\"></div><p class=\"repo-empty paper-empty-note\" hidden></p></section>\n</div>\n";
---
<Fragment set:html={localizePaper(before,lang)}/><WorksSection lang={lang}/><Fragment set:html={localizePaper(after,lang)}/>
