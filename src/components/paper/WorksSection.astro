---
import {getFeaturedWorks,getWorks,slugOf} from '../../lib/content';
import type {Lang} from '../../i18n/ui';
const {lang='zh'}=Astro.props as {lang:Lang};
const works=await getFeaturedWorks(lang);const allWorks=await getWorks(lang);const other=await getFeaturedWorks(lang==='zh'?'en':'zh');
---
<section class="content works-section folio-sheet" id="works">
<div class="works-header"><div><span class="works-kicker" data-zh="Creative Engineering / 精选" data-en="Creative Engineering / Selected">Creative Engineering / {lang==='zh'?'精选':'Selected'}</span><h2 data-zh="作品" data-en="Works">{lang==='zh'?'作品':'Works'}</h2></div><div class="works-toolbar"><div class="work-filter"><button data-work-filter="all" aria-pressed="true" data-zh="精选" data-en="Selected">{lang==='zh'?'精选':'Selected'}</button></div><div class="work-view"><button data-work-view="grid" aria-pressed="true" aria-label={lang==='zh'?'网格展示':'Grid view'}><span class="grid-icon"><i></i><i></i><i></i><i></i></span></button><button data-work-view="list" aria-pressed="false" aria-label={lang==='zh'?'清单展示':'List view'}><span class="list-icon"><i></i><i></i><i></i></span></button></div></div></div>
<div class="work-grid">
{works.map(work=>{const translated=other.find(x=>slugOf(x.id)===slugOf(work.id));const zh=lang==='zh'?work:translated,en=lang==='en'?work:translated;return <article class="work-card" data-work-kind="project" data-work-slug={slugOf(work.id)}><div class="work-image"><button class="work-art-open" data-entry={slugOf(work.id)} aria-label={work.data.title}>{work.data.cover?<img src={work.data.cover.src} alt={work.data.title+' — '+(lang==='zh'?'项目仓库原有截图':'Existing repository screenshot')} loading="lazy" width={work.data.cover.width} height={work.data.cover.height}/>:<div class="project-title-cover"><small data-zh={zh?.data.category} data-en={en?.data.category}>{work.data.category}</small><strong data-zh={zh?.data.title} data-en={en?.data.title}>{work.data.title}</strong><span>{work.data.stack}</span></div>}</button><span class="asset-disclosure" data-zh={work.data.cover?'仓库原有截图':'项目文字卡 / 非截图'} data-en={work.data.cover?'Existing repository screenshot':'Text card / No fabricated screenshot'}>{lang==='zh'?(work.data.cover?'仓库原有截图':'项目文字卡 / 非截图'):(work.data.cover?'Existing repository screenshot':'Text card / No fabricated screenshot')}</span></div><div class="work-info"><div class="work-meta"><span data-zh={zh?.data.category} data-en={en?.data.category}>{work.data.category}</span></div><div class="work-title-row"><h3 data-zh={zh?.data.title} data-en={en?.data.title}>{work.data.title}</h3><button class="work-open" data-entry={slugOf(work.id)} aria-label={work.data.title}>↗</button></div><p class="work-summary" data-zh={zh?.data.summary} data-en={en?.data.summary}>{work.data.summary}</p><small class="project-status" data-zh={zh?.data.status} data-en={en?.data.status}>{work.data.status}</small><div class="work-actions"><button data-entry={slugOf(work.id)} data-zh="项目详情" data-en="Details">{lang==='zh'?'项目详情':'Details'}</button><a href={work.data.link} target="_blank" rel="noopener">GitHub ↗</a></div></div></article>})}
</div><div class="works-footer"><button class="works-all" data-open="0"><span data-zh="全部作品" data-en="All works">{lang==='zh'?'全部作品':'All works'}</span><span class="works-total">{String(allWorks.length).padStart(2,'0')}</span><span>→</span></button><a href={`/${lang}/works/`} data-zh="完整列表 ↗" data-en="Full list ↗">{lang==='zh'?'完整列表 ↗':'Full list ↗'}</a></div>
</section>
