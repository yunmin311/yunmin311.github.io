---
import { localizePaper } from "../../lib/paper-home";
const { lang = "zh" } = Astro.props;
const markup = "<section class=\"look\" id=\"home\" data-mode=\"a\"><nav class=\"nav\" aria-label=\"网站导航\"><button class=\"brand\" style=\"border:0;background:none;padding:0\" aria-label=\"返回首页\">Yunmin</button><div class=\"nav-links\"><i class=\"nav-lens\" aria-hidden=\"true\"></i><button data-open=\"0\" data-zh=\"作品\" data-en=\"Works\">作品</button><button data-open=\"1\" data-zh=\"文字\" data-en=\"Writing\">文字</button><button data-scroll=\"about\" data-zh=\"关于\" data-en=\"About\">关于</button><button class=\"language\" aria-label=\"切换语言\">EN</button></div></nav><div class=\"hero-intro\"><div class=\"headline\"><h1>Yunmin<span class=\"period\">.</span></h1><p data-zh=\"作品、随笔与过程手记\" data-en=\"Works, writing, and process notes.\">作品、随笔与过程手记</p></div><div class=\"hero-links\"><button data-open=\"0\" data-zh=\"打开作品 ↗\" data-en=\"Open works ↗\">打开作品 ↗</button><button data-open=\"1\" data-zh=\"读点文字 ↗\" data-en=\"Read a note ↗\">读点文字 ↗</button></div></div><div class=\"stage\" aria-label=\"可点击的三维纸张\"><div class=\"loading\" role=\"status\">正在展开纸张…</div></div><div class=\"card-controls\" hidden><button class=\"card-prev\" hidden>←</button><span class=\"card-status\" hidden>01 / 03</span><button class=\"card-next\" hidden>→</button></div><div class=\"photo-ruler\"><div class=\"photo-slider\" role=\"slider\" tabindex=\"0\" aria-label=\"三张纸卡切换刻度\" aria-valuemin=\"0\" aria-valuemax=\"2\" aria-valuenow=\"0\" aria-orientation=\"vertical\"><span class=\"photo-tick\" style=\"top:18px\"></span><span class=\"photo-tick\" style=\"top:50%\"></span><span class=\"photo-tick\" style=\"bottom:18px\"></span></div></div><div class=\"hint\"><span data-zh=\"3D 纸卡为公开素材试样，非个人作品。\" data-en=\"Public-domain card study, not personal work.\">3D 纸卡为公开素材试样，非个人作品。</span><a href=\"https://polyhaven.com/a/postcard_set_01\" target=\"_blank\" rel=\"noopener\">Poly Haven / CC0</a></div><article class=\"reader\" inert aria-label=\"纸面内容\"><div class=\"reader-head\"><span class=\"reader-tag\" data-zh=\"现有内容 · 占位\" data-en=\"Existing content · Placeholder\">现有内容 · 占位</span><button class=\"close\" aria-label=\"合上纸页\">×</button></div><h2 id=\"reader-title\">Works</h2><h3 id=\"reader-subtitle\">作品</h3><ul class=\"reader-list\"></ul><p class=\"reader-note\"></p></article></section>";
---
<Fragment set:html={localizePaper(markup,lang)} />
