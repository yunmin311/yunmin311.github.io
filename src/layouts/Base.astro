---
import '../styles/tokens.css';
import EdgeRuler from '../components/paper/EdgeRuler.astro';
import { t, defaultLang, type Lang } from '../i18n/ui';
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
  title?: string;
  description?: string;
  /**
   * 另一语言对应页的路径。
   * 不传 = 按语言前缀互换(两边都存在的页面);
   * null = 对应翻译不存在(切换跳该语言首页,且不输出 hreflang 互指)。
   */
  altPath?: string | null;
  /** og 分享卡片图;作品页传封面,其余用全站统一占位图(规格·搜索与分享) */
  ogImage?: string;
}

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const otherLang: Lang = lang === 'zh' ? 'en' : 'zh';
const siteName = t(lang, 'site.name');
const {
  title,
  description = t(lang, 'site.description'),
  altPath,
  ogImage = '/og-placeholder.png',
} = Astro.props;
const pageTitle = title ? `${title} — ${siteName}` : siteName;

const currentPath = Astro.url.pathname;
const swappedPath = currentPath.replace(new RegExp(`^/${lang}(?=/|$)`), `/${otherLang}`);
const hasAlt = altPath !== null;
const switchPath = hasAlt ? (altPath ?? swappedPath) : getRelativeLocaleUrl(otherLang);

const abs = (path: string) => new URL(path, Astro.site).href;
const zhPath = lang === 'zh' ? currentPath : switchPath;

const nav = [
  { href: getRelativeLocaleUrl(lang, 'works'), label: t(lang, 'nav.works') },
  { href: getRelativeLocaleUrl(lang, 'blog'), label: t(lang, 'nav.blog') },
  { href: getRelativeLocaleUrl(lang, 'about'), label: t(lang, 'nav.about') },
];
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={abs(currentPath)} />
    {hasAlt && <link rel="alternate" hreflang={lang === 'zh' ? 'zh-CN' : 'en'} href={abs(currentPath)} />}
    {hasAlt && <link rel="alternate" hreflang={otherLang === 'zh' ? 'zh-CN' : 'en'} href={abs(switchPath)} />}
    {hasAlt && <link rel="alternate" hreflang="x-default" href={abs(zhPath)} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={abs(currentPath)} />
    <meta property="og:image" content={abs(ogImage)} />

<link rel="stylesheet" href="/assets/paper/theme.css" />
</head>
<body class="paper-page">
<div class="cloud-sky" aria-hidden="true"></div>
<header class="subpage-header"><a class="subpage-brand" href={getRelativeLocaleUrl(lang)}>Yunmin</a><nav aria-label={lang==='zh'?'网站导航':'Site navigation'}>{nav.map(item=><a href={item.href} aria-current={currentPath.startsWith(item.href)?'page':undefined}>{item.label}</a>)}<a class="subpage-language" href={switchPath}>{otherLang==='en'?'EN':'中'}</a></nav></header>
<main class="site-main"><div class="page-reading-layer"><a class="page-back" href={getRelativeLocaleUrl(lang)}>← {lang==='zh'?'回到首页':'Back home'}</a><slot /></div></main>
<footer class="site-footer"><span>© {year} Yunmin</span><div><button class="reduce" aria-pressed="false">{lang==='zh'?'减少动效':'Reduce motion'}</button><a href="/assets/paper/LICENSES/NOTICE.md">{lang==='zh'?'素材与许可':'Assets & licenses'}</a></div></footer>
<EdgeRuler/>
<script is:inline src="/assets/paper/page-chrome.js" defer></script>
</body>
</html>
