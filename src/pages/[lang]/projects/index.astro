---
import {getCollection} from 'astro:content';
import Base from '../../../layouts/Base.astro';
import {locales,type Lang} from '../../../i18n/ui';
import {slugOf} from '../../../lib/content';
export function getStaticPaths(){return locales.map(lang=>({params:{lang}}));}
const lang=Astro.params.lang as Lang;
const archive=await getCollection('projectIdeas',({id,data})=>id.startsWith('zh/')&&!data.draft);
const notes=(await getCollection('reflections',({id})=>id.startsWith(lang+'/'))).sort((a,b)=>b.data.date.getTime()-a.data.date.getTime());
const projects=[...new Set(notes.map(note=>note.data.project))];
const title=lang==='zh'?'项目过程与复盘':'Project process & reflections';
---
<Base title={title}>
<h1>{title}</h1>
{notes.length===0?<section class="notice-empty" data-process-empty><p>{lang==='zh'?'项目过程与复盘尚未公开。当前成果可以在作品与代码库中查看。':'Project process notes and reflections are not published yet. Current outcomes are documented in Works and Repos.'}</p><div class="repo-links"><a href={`/${lang}/works/`}>{lang==='zh'?'查看作品 →':'View portfolio →'}</a><a href={`/${lang}/repos/`}>{lang==='zh'?'查看代码库 →':'View repositories →'}</a></div></section>:<>
{projects.map(project=><section class="catalog-group"><h2>{project}</h2><div class="route-cards">{notes.filter(note=>note.data.project===project).map(note=><a class="route-card" href={`/${lang}/project-notes/${slugOf(note.id)}/`}><small>{note.data.kind==='复盘'?'Reflection':'Process'} · {note.data.date.toISOString().slice(0,10)}</small><h3>{note.data.title}</h3><p>{note.data.summary}</p></a>)}</div></section>)}
<section class="catalog-group" data-process-timeline><h2>{lang==='zh'?'最近更新':'Recent updates'}</h2>{notes.map(note=><p><time>{note.data.date.toISOString().slice(0,10)}</time> · {note.data.project} · <a href={`/${lang}/project-notes/${slugOf(note.id)}/`}>{note.data.title}</a> · {note.data.kind==='复盘'?'Reflection':'Process'}</p>)}</section>
</>}
<section class="catalog-group" data-ideas-archive><h2>Archive / Earlier ideas · 2026-05</h2><p class="source-note">{lang==='zh'?'六个旧想法。状态来自原稿，不代表当前进度。':'Six earlier ideas have Chinese historical drafts only. Original statuses are preserved; they do not describe current progress.'}</p><div class="route-cards">{archive.map(entry=><a class="route-card" href={`/zh/projects/${slugOf(entry.id)}/`}><small>Historical / 2026-05 · {entry.data.historicalStatus}</small><h2>{entry.data.title}</h2>{lang==='zh'&&<><p>{entry.data.summary}</p><div class="route-tags">{entry.data.tags.map(tag=><span>{tag}</span>)}</div></>}</a>)}</div></section>
</Base>
