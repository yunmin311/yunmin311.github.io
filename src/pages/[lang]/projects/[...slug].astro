---
import {getCollection,render} from 'astro:content';
import Base from '../../../layouts/Base.astro';
import {type Lang} from '../../../i18n/ui';
import {slugOf} from '../../../lib/content';
export async function getStaticPaths(){const entries=await getCollection('projectIdeas',({data})=>!data.draft);return entries.map(entry=>({params:{lang:entry.id.split('/')[0],slug:slugOf(entry.id)},props:{entry}}));}
const{entry}=Astro.props;const lang=Astro.params.lang as Lang;const{Content}=await render(entry);
const counterpart=await getCollection('projectIdeas',({id,data})=>id===`${lang==='zh'?'en':'zh'}/${slugOf(entry.id)}`&&!data.draft);
---
<Base title={entry.data.title} description={entry.data.summary} altPath={counterpart.length?undefined:null}>
<h1>{entry.data.title}</h1><p class="source-note">2026-05 旧稿 · 原状态：{entry.data.historicalStatus}。当前进度待更新。</p>
<div class="route-tags">{entry.data.tags.map(tag=><span>{tag}</span>)}</div><div class="note-body"><Content/></div><a class="page-back" href={`/${lang}/projects/`}>← {lang==='zh'?'返回项目记录':'Back to projects'}</a>
</Base>
