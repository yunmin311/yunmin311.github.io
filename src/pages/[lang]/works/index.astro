---
import {projectGroups} from '../../../lib/catalog';
import Base from '../../../layouts/Base.astro';
import WorkCard from '../../../components/WorkCard.astro';
import { getWorks } from '../../../lib/content';
import { t, locales, type Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const works = await getWorks(lang);
---

<Base title={t(lang, 'works.title')}>
  <h1 class="page-title">{t(lang, 'works.title')}</h1>
  <p class="source-note">{lang==='zh'?'完整项目目录；Obsidian 插件、配置与笔记规范放在同一组。Release 标记区分正式版本、预发布与仅源码发布。':'Complete project directory. Obsidian plugins, configuration and note standards share one group. Releases distinguish stable, pre-release and source-only publications.'}</p>{projectGroups.filter(group=>works.some(w=>w.data.group===group.id)).map(group=><section class="catalog-group" id={group.id}><h2>{group[lang]}</h2><div class="works-grid">{works.filter(w=>w.data.group===group.id).map(work=><WorkCard work={work} lang={lang}/>)}</div></section>)}
</Base>

<style>
  .page-title {
    margin: 0 0 var(--space-4);
    font-size: var(--text-xl);
    font-weight: 600;
  }
  .works-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--grid-gap);
  }
  @media (max-width: 64rem) {
    .works-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 40rem) {
    .works-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
