---
import RepoCatalog from '../../../components/RepoCatalog.astro';
import {getCollection} from 'astro:content';
import Base from '../../../layouts/Base.astro';
import {locales,type Lang} from '../../../i18n/ui';
import {slugOf,getWorks} from '../../../lib/content';
const mapping={'project-notes':'reflections',learning:'learning',repos:'code'} as const;
export function getStaticPaths(){return ['project-notes','learning','repos'].flatMap(section=>locales.map(lang=>({params:{lang,section}})));}
const lang=Astro.params.lang as Lang,section=Astro.params.section as keyof typeof mapping;
const collection=mapping[section];const entries=await getCollection(collection,({id})=>id.startsWith(lang+'/'));entries.sort((a,b)=>b.data.date.getTime()-a.data.date.getTime());
const titles={'project-notes':['过程与复盘','Process & reflections'],learning:['学习记录','Learning'],repos:['代码库','Repositories']} as const;
const title=titles[section][lang==='zh'?0:1];
const works=await getWorks(lang);
const curated=section==='repos'?works:section==='learning'?works.filter(w=>['text-structure','densegpt','context-distiller'].includes(slugOf(w.id))):[];
---
<Base title={title}>
<h1>{title}</h1>
{section==='repos'&&<RepoCatalog lang={lang}/>}
{section==='learning'&&<><p class="source-note">{lang==='zh'?'公开知识项目的资料入口，不代表个人学习记录。':'Public project documentation, not personal learning records.'}</p><div class="route-cards">{curated.map(work=><article class="route-card"><h2>{work.data.title}</h2><p>{work.data.summary}</p><a href={work.data.sources[0].url} target="_blank" rel="noopener">{lang==='zh'?'一手资料':'Primary source'} ↗</a></article>)}</div></>}
{entries.length>0&&<h2>{lang==='zh'?'已同步的公开记录':'Published synced records'}</h2>}
<div class="route-cards">{entries.map(entry=><a class="route-card" href={`/${lang}/${section}/${slugOf(entry.id)}/`}><small>{entry.data.date.toISOString().slice(0,10)}</small><h2>{entry.data.title}</h2><p>{entry.data.summary}</p></a>)}</div>
{entries.length===0&&<p class="notice-empty">{lang==='zh'?'个人笔记尚未公开发布；不会用展示试样代替真实记录。':'No personal notes are published here yet. Display studies do not substitute for real records.'}</p>}
</Base>
