---
import {getCollection,render} from 'astro:content';
import Base from '../../../layouts/Base.astro';
import {type Lang} from '../../../i18n/ui';
import {slugOf,hasTranslation} from '../../../lib/content';
export async function getStaticPaths(){const mapping={'project-notes':'reflections',learning:'learning',repos:'code'} as const;const paths=[];for(const [section,collection]of Object.entries(mapping)){const entries=await getCollection(collection);for(const entry of entries)paths.push({params:{lang:entry.id.split('/')[0],section,slug:slugOf(entry.id)},props:{entry,collection}});}return paths;}
const{entry,collection}=Astro.props;const lang=Astro.params.lang as Lang,section=Astro.params.section!;
const{Content}=await render(entry);const other=lang==='zh'?'en':'zh';const alt=await getCollection(collection,({id})=>id===`${other}/${slugOf(entry.id)}`);const work='work'in entry.data?entry.data.work:null;const linkedWork=work?await hasTranslation('works',lang,work):false;
---
<Base title={entry.data.title} description={entry.data.summary} altPath={alt.length?undefined:null}>
<h1>{entry.data.title}</h1><p class="source-note">{entry.data.date.toISOString().slice(0,10)}</p><p>{entry.data.summary}</p><div class="note-body"><Content/></div>
{'repo'in entry.data&&<a class="page-back" href={entry.data.repo} target="_blank" rel="noopener">GitHub ↗</a>}
{linkedWork&&<a class="page-back" href={`/${lang}/works/${work}/`}>{lang==='zh'?'去看作品 ↗':'View work ↗'}</a>}
<a class="page-back" href={`/${lang}/${section}/`}>← {lang==='zh'?'返回列表':'Back to list'}</a>
</Base>
