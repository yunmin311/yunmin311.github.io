---
import Base from '../../layouts/Base.astro';
import {locales,type Lang,t} from '../../i18n/ui';
import {profile} from '../../lib/profile';
export function getStaticPaths(){return locales.map(lang=>({params:{lang}}));}
const lang=Astro.params.lang as Lang;
---
<Base title={t(lang,'about.title')}>
<h1>{profile.name}</h1>
<p class="source-note">{profile.education[lang]} · Creative Engineering</p>
<p>{profile.intro[lang]}</p><p>{profile.about[lang]}</p><p>{profile.principle[lang]}</p>
<h2>{lang==='zh'?'联系':'Contact'}</h2><div class="contact"><a href={profile.github} target="_blank" rel="noopener">GitHub ↗</a><span>{lang==='zh'?'其他联系方式和简历尚未确认公开。':'Other contact channels and résumé are not yet confirmed for publication.'}</span></div>
</Base>
